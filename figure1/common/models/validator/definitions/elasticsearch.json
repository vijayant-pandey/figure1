        },
        "countryName": {
          "type": "string"
        },
        "countryCode": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        },
        "specialtyUuid": {
          "$ref": "dataTypes#/definitions/UUID"
        },
