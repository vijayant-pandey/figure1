{
  "$schema": "http://json-schema.org/schema#",
  "id": "dataTypes",
  "definitions": {
    "UUID": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "ObjectId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}"
    },
    "CommentAuthorId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-fA-F]{24}"
    },
    "freeText10k": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10000
    },
    "freeText1k": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000
    },
    "Email": {
      "type": "string",
      "pattern": "(?:[a-z0-9!#$%&'*+/=?^_`{|}~-]+(?:\\.[a-z0-9!#$%&'*+/=?^_`{|}~-]+)*|\"(?:[\\x01-\\x08\\x0b\\x0c\\x0e-\\x1f\\x21\\x23-\\x5b\\x5d-\\x7f]|\\\\[\\x01-\\x09\\x0b\\x0c\\x0e-\\x7f])*\")@(?:(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]*[a-z0-9])?|\\[(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?|[a-z0-9-]*[a-z0-9]:(?:[\\x01-\\x08\\x0b\\x0c\\x0e-\\x1f\\x21-\\x5a\\x53-\\x7f]|\\\\[\\x01-\\x09\\x0b\\x0c\\x0e-\\x7f])+)\\])"
    },
    "Device": {
      "type": "object",
      "properties": {
        "device_id": {
          "type": "string"
        },
        "device_type": {
          "type": "string",
          "enum": [
            "web",
            "ios",
            "android"
          ]
        },
        "fcm_token": {
          "type": "string"
        },
        "device_language": {
          "type": "string"
        }
      },
      "required": [
        "device_id",
        "device_type",
        "fcm_token"
      ]
    },
    "UserExperience": {
      "type": "object",
      "properties": {
        "location": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "startYear": {
          "type": "number",
          "minimum": 1900,
          "maximum": 2100
        },
        "endYear": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1900,
          "maximum": 2100
        },
        "isCurrent": {
          "type": "boolean"
        },
        "experienceUuid": {
          "$ref": "dataTypes#/definitions/UUID"
        },
        "educationUuid": {
          "$ref": "dataTypes#/definitions/UUID"
        },
        "affiliationUuid": {
          "$ref": "dataTypes#/definitions/UUID"
        }
      },
      "required": [
        "description",
        "startYear"
      ]
    }
  }
}
